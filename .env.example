# Copy to .env and fill in. Never commit .env.

# MongoDB. Local dev: the MongoDB Windows service on the default port.
MONGO_URI=mongodb://127.0.0.1:27017/ramfarid

# Public base URL of the R2 bucket that holds the CV, project covers and screenshots, e.g. https://media.ramfarid.com.
# next/image only loads remote images under it (next.config.ts), so set it before builds that show project images.
R2_PUBLIC_URL=https://pub-ab4eb754a68c497e8c690087ee88a5a0.r2.dev

# Cloudflare Turnstile (contact form). These are Cloudflare's always-pass test keys. Production uses the widget's keys
# from the Cloudflare dashboard; those only work on the widget's listed hostnames (localhost gives error 110200), so keep
# the real keys here in .env and the test keys in .env.development.local, which only `next dev` loads.
# The site key is public and inlined at build time.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Telegram bot for contact notifications. Unset: messages are still saved; the notification is skipped with a warning.
TELEGRAM_BOT_TOKEN=
# The "Contact Notifications" group's chat id (a negative number, e.g. -100…).
TELEGRAM_CONTACT_CHAT_ID=
# Console sign-in codes go to this chat; console sign-in is off while it (or the bot token) is unset.
TELEGRAM_OTP_CHAT_ID=
# Owner notices, such as a new console sign-in. Optional.
TELEGRAM_OWNER_CHAT_ID=

# Cloudflare R2 S3 API credentials (an API token with Object Read & Write on the bucket), for console uploads.
# Uploads are off until all of these and R2_PUBLIC_URL are set. The bucket needs a CORS rule allowing PUT from the
# console's origins. See docs/console.md#uploads
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# The site's public origin, for absolute links sent outside the site. Optional: defaults to https://ramfarid.com.
SITE_URL=
