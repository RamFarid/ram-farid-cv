# Copy to .env and fill in. Never commit .env.

# MongoDB. Local dev: the MongoDB Windows service on the default port.
MONGO_URI=mongodb://127.0.0.1:27017/ramfarid

# Public URL of the CV file in R2. Optional: unset disables the Download CV buttons. The console will manage it later.
CV_URL=

# Cloudflare Turnstile (contact form). These are Cloudflare's always-pass test keys, for local dev only;
# production uses the site's keys from the Cloudflare dashboard. The site key is public and inlined at build time.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Telegram bot for contact notifications. Unset: messages are still saved; the notification is skipped with a warning.
TELEGRAM_BOT_TOKEN=
# The "Contact Notifications" group's chat id (a negative number, e.g. -100…).
TELEGRAM_CONTACT_CHAT_ID=

# The site's public origin, for absolute links sent outside the site. Optional: defaults to https://ramfarid.com.
SITE_URL=
